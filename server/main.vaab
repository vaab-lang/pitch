# Vaab-written API server for the landing page.
# Run with: vaab serve server/main.vaab
#
# Demonstrates that Vaab backends are first-class — the playground runner
# (Rust + embedded VM) handles arbitrary user code; this server handles
# curated endpoints written in Vaab itself.

type Health can Json {
    ok: Bool
    service: Text
    language: Text
}

type Example can Json {
    name: Text
    description: Text
    code: Text
}

type Examples can Json {
    examples: list of Example
}

serve on port 8788 {
    route get "/health" {
        reply with Health.new(
            ok: yes,
            service: "vaab-site",
            language: "vaab"
        )
    }

    route get "/api/examples" {
        reply with Examples.new(examples: [
            Example.new(
                name: "hello",
                description: "The smallest Vaab program",
                code: "let name = \"world\"\nprint(\"hello, {name}\")"
            ),
            Example.new(
                name: "collections",
                description: "Lists, maps, and functional style",
                code: "let nums = [1, 2, 3]\nprint(nums.map(n -> n * n))"
            ),
            Example.new(
                name: "types",
                description: "Types with methods and errors",
                code: "type Counter { value: Int = 0\n  to bump() returns Counter { return self.with(value: self.value + 1) }\n}\nprint(Counter.new().bump().bump().value)"
            ),
        ])
    }
}
