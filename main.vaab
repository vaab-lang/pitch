# site — landing page, playground, and todo demo at vaab.dev
#
#   cd web && npm run build
#   vaab serve main.vaab
#
# POST /api/run is handled natively by vaab-server (embedded VM playground).
# Todos live at vaab.dev/tasks (same service — Render is limited to two
# custom domains, so the todo demo moved off todo.vaab.dev).
# The riff registry is a second service at riff.vaab.dev (main-riff.vaab).

choice ApiError {
    BadRequest(message: Text)
    Store(message: Text)
}

type Health {
    ok: Bool
    service: Text
}

type NewTodo {
    title: Text
}

type OkCount {
    ok: Bool
    count: Int
}

type Cleared {
    ok: Bool
}

log.info("site starting")

api_from_store(error: StoreError) returns ApiError {
    match error {
        when Failed(message) then { return ApiError.Store(message) }
    }
}

open_todos() returns Store or fails ApiError {
    match Store.open("todo-todos.vaab.kv") {
        when success store then { return store }
        when failure error then { fail api_from_store(error) }
    }
}

visitor_ok(visitor: Text) returns Bool {
    if visitor.is_empty { return no }
    if visitor.contains("..") { return no }
    if visitor.contains("/") { return no }
    if visitor.contains(":") { return no }
    if visitor.contains(" ") { return no }
    return yes
}

prefix_for(visitor: Text) returns Text {
    return "todo:{visitor}:"
}

list_todos(visitor: Text) returns [{Text: Text}] or fails ApiError {
    if not visitor_ok(visitor) {
        fail ApiError.BadRequest("bad visitor")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    match store.from(prefix).order_desc("created").all() {
        when success rows then { return rows }
        when failure error then { fail api_from_store(error) }
    }
}

create_todo(visitor: Text, title: Text) returns {Text: Text} or fails ApiError {
    if not visitor_ok(visitor) {
        fail ApiError.BadRequest("bad visitor")
    }
    if title.is_empty {
        fail ApiError.BadRequest("title is required")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    match store.from(prefix).count() {
        when success existing then {
            let id = "{now()}-{existing}"
            let key = "{prefix}{id}"
            let created = "{now()}"
            match store.from(prefix).insert({
                "key": key,
                "id": id,
                "title": title,
                "done": "no",
                "created": created,
            }) {
                when success _ then {
                    return {
                        "key": key,
                        "id": id,
                        "title": title,
                        "done": "no",
                        "created": created,
                    }
                }
                when failure error then { fail api_from_store(error) }
            }
        }
        when failure error then { fail api_from_store(error) }
    }
}

toggle_todo(visitor: Text, id: Text) returns {Text: Text} or fails ApiError {
    if not visitor_ok(visitor) {
        fail ApiError.BadRequest("bad visitor")
    }
    if id.is_empty or id.contains("..") or id.contains("/") {
        fail ApiError.BadRequest("bad id")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    let key = "{prefix}{id}"
    match store.from(prefix).where("key").is(key).first() {
        when success found_row then {
            match found_row {
                when found row then {
                    let done = row.get("done") otherwise "no"
                    let next = if done == "yes" { "no" } else { "yes" }
                    match store.from(prefix).where("key").is(key).update({"done": next}) {
                        when success _ then {
                            let title = row.get("title") otherwise ""
                            let created = row.get("created") otherwise ""
                            return {
                                "key": key,
                                "id": id,
                                "title": title,
                                "done": next,
                                "created": created,
                            }
                        }
                        when failure error then { fail api_from_store(error) }
                    }
                }
                when nothing then {
                    fail ApiError.BadRequest("todo not found")
                }
            }
        }
        when failure error then { fail api_from_store(error) }
    }
}

delete_todo(visitor: Text, id: Text) returns OkCount or fails ApiError {
    if not visitor_ok(visitor) {
        fail ApiError.BadRequest("bad visitor")
    }
    if id.is_empty or id.contains("..") or id.contains("/") {
        fail ApiError.BadRequest("bad id")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    let key = "{prefix}{id}"
    match store.from(prefix).where("key").is(key).delete() {
        when success count then { return OkCount.new(ok: yes, count: count) }
        when failure error then { fail api_from_store(error) }
    }
}

clear_todos(visitor: Text) returns Cleared or fails ApiError {
    if not visitor_ok(visitor) {
        fail ApiError.BadRequest("bad visitor")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    match store.from(prefix).delete() {
        when success _ then { return Cleared.new(ok: yes) }
        when failure error then { fail api_from_store(error) }
    }
}

explain(error: ApiError) returns Text {
    match error {
        when BadRequest(message) then { return message }
        when Store(message) then { return message }
    }
}

serve on port 8787 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    route get "/health" {
        reply with Health.new(ok: yes, service: "site")
    }

    route get "/api/todos/{visitor: Text}" {
        reply with try list_todos(visitor)
    }

    route post "/api/todos/{visitor: Text}" expecting NewTodo as body {
        reply with try create_todo(visitor, body.title) status 201
    }

    route post "/api/todos/{visitor: Text}/{id: Text}/toggle" {
        reply with try toggle_todo(visitor, id)
    }

    route post "/api/todos/{visitor: Text}/{id: Text}/delete" {
        reply with try delete_todo(visitor, id)
    }

    route post "/api/todos/{visitor: Text}/clear" {
        reply with try clear_todos(visitor)
    }

    when anything fails with ApiError as error {
        reply text explain(error) as "text/plain; charset=utf-8" status 400
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/tasks" {
        reply file "web/dist/index.html"
    }

    route get "/spec" {
        reply file "web/dist/index.html"
    }

    route get "/decisions" {
        reply file "web/dist/index.html"
    }

    route get "/changelog" {
        reply file "web/dist/index.html"
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        } else {
            reply file "web/dist/{filepath}"
        }
    }
}
