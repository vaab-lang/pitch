# pitch — the Vaab landing page, playground, and static assets in one server.
#
#   cd web && npm run build
#   vaab serve main.vaab
#
# POST /api/run is handled natively by vaab-server (embedded VM playground).
# Static paths follow the same rules as deck.for_path.

need deck from ./riffs/deck

type Health can Json {
    ok: Bool
    service: Text
}

serve on port 8787 {
    route get "/health" {
        reply with Health.new(ok: yes, service: "pitch")
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        }

        let name = if filepath.is_empty { "index.html" } else { filepath }
        let target = "web/dist/{name}"
        reply file target
    }
}
