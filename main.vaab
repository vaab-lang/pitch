# pitch — landing page, playground, and KV-backed todo demo.
#
#   cd web && npm run build
#   vaab serve main.vaab
#
# POST /api/run is handled natively by vaab-server (embedded VM playground).
# Todos are scoped per visitor id (cookie on the client, path segment here).

choice StoreError {
    Failed(message: Text)
}

choice ApiError {
    BadRequest(message: Text)
    Store(message: Text)
}

type Health can Json {
    ok: Bool
    service: Text
}

type NewTodo can Json {
    title: Text
}

type OkCount can Json {
    ok: Bool
    count: Int
}

type Cleared can Json {
    ok: Bool
}

to api_from_store(error: StoreError) returns ApiError {
    match error {
        when Failed(message) then { return ApiError.Store(message) }
    }
}

to open_todos() returns Store or fails ApiError {
    match Store.open("pitch-todos.vaab.kv") {
        when success store then { return success store }
        when failure error then { return failure api_from_store(error) }
    }
}

to visitor_ok(visitor: Text) returns Bool {
    if visitor.is_empty { return no }
    if visitor.contains("..") { return no }
    if visitor.contains("/") { return no }
    if visitor.contains(":") { return no }
    if visitor.contains(" ") { return no }
    return yes
}

to prefix_for(visitor: Text) returns Text {
    return "todo:{visitor}:"
}

to list_todos(visitor: Text) returns list of map of Text to Text or fails ApiError {
    if not visitor_ok(visitor) {
        return failure ApiError.BadRequest("bad visitor")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    match store.from(prefix).order_desc("created").all() {
        when success rows then { return success rows }
        when failure error then { return failure api_from_store(error) }
    }
}

to create_todo(visitor: Text, title: Text) returns map of Text to Text or fails ApiError {
    if not visitor_ok(visitor) {
        return failure ApiError.BadRequest("bad visitor")
    }
    if title.is_empty {
        return failure ApiError.BadRequest("title is required")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    match store.from(prefix).count() {
        when success existing then {
            let id = "{now()}-{existing}"
            let key = "{prefix}{id}"
            let created = "{now()}"
            match store.from(prefix).insert({
                "key": key,
                "id": id,
                "title": title,
                "done": "no",
                "created": created,
            }) {
                when success _ then {
                    return success {
                        "key": key,
                        "id": id,
                        "title": title,
                        "done": "no",
                        "created": created,
                    }
                }
                when failure error then { return failure api_from_store(error) }
            }
        }
        when failure error then { return failure api_from_store(error) }
    }
}

to toggle_todo(visitor: Text, id: Text) returns map of Text to Text or fails ApiError {
    if not visitor_ok(visitor) {
        return failure ApiError.BadRequest("bad visitor")
    }
    if id.is_empty or id.contains("..") or id.contains("/") {
        return failure ApiError.BadRequest("bad id")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    let key = "{prefix}{id}"
    match store.from(prefix).where_eq("key", key).first() {
        when success found_row then {
            match found_row {
                when found row then {
                    let done = row.get("done") otherwise "no"
                    let next = if done == "yes" { "no" } else { "yes" }
                    match store.from(prefix).where_eq("key", key).update({"done": next}) {
                        when success _ then {
                            let title = row.get("title") otherwise ""
                            let created = row.get("created") otherwise ""
                            return success {
                                "key": key,
                                "id": id,
                                "title": title,
                                "done": next,
                                "created": created,
                            }
                        }
                        when failure error then { return failure api_from_store(error) }
                    }
                }
                when nothing then {
                    return failure ApiError.BadRequest("todo not found")
                }
            }
        }
        when failure error then { return failure api_from_store(error) }
    }
}

to delete_todo(visitor: Text, id: Text) returns OkCount or fails ApiError {
    if not visitor_ok(visitor) {
        return failure ApiError.BadRequest("bad visitor")
    }
    if id.is_empty or id.contains("..") or id.contains("/") {
        return failure ApiError.BadRequest("bad id")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    let key = "{prefix}{id}"
    match store.from(prefix).where_eq("key", key).delete() {
        when success count then { return success OkCount.new(ok: yes, count: count) }
        when failure error then { return failure api_from_store(error) }
    }
}

to clear_todos(visitor: Text) returns Cleared or fails ApiError {
    if not visitor_ok(visitor) {
        return failure ApiError.BadRequest("bad visitor")
    }
    let store = try open_todos()
    let prefix = prefix_for(visitor)
    match store.from(prefix).delete() {
        when success _ then { return success Cleared.new(ok: yes) }
        when failure error then { return failure api_from_store(error) }
    }
}

to explain(error: ApiError) returns Text {
    match error {
        when BadRequest(message) then { return message }
        when Store(message) then { return message }
    }
}

serve on port 8787 {
    route get "/health" {
        reply with Health.new(ok: yes, service: "pitch")
    }

    route get "/api/todos/{visitor: Text}" {
        reply with try list_todos(visitor)
    }

    route post "/api/todos/{visitor: Text}" expecting NewTodo as body {
        reply with try create_todo(visitor, body.title) status 201
    }

    route post "/api/todos/{visitor: Text}/{id: Text}/toggle" {
        reply with try toggle_todo(visitor, id)
    }

    route post "/api/todos/{visitor: Text}/{id: Text}/delete" {
        reply with try delete_todo(visitor, id)
    }

    route post "/api/todos/{visitor: Text}/clear" {
        reply with try clear_todos(visitor)
    }

    when anything fails with ApiError as error {
        reply text explain(error) as "text/plain; charset=utf-8" status 400
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/spec" {
        reply file "web/dist/index.html"
    }

    route get "/decisions" {
        reply file "web/dist/index.html"
    }

    route get "/tasks" {
        reply file "web/dist/index.html"
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        } else {
            reply file "web/dist/{filepath}"
        }
    }
}
