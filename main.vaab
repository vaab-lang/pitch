# site — landing page and playground at vaab.dev
#
#   cd web && npm run build
#   vaab serve main.vaab
#
# POST /api/run is handled natively by vaab-server (embedded VM playground).
# Todos live at todo.vaab.dev; the riff registry lives at riff.vaab.dev.

type Health {
    ok: Bool
    service: Text
}

log.info("site starting")

serve on port 8787 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    route get "/health" {
        reply with Health.new(ok: yes, service: "site")
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/spec" {
        reply file "web/dist/index.html"
    }

    route get "/decisions" {
        reply file "web/dist/index.html"
    }

    route get "/changelog" {
        reply file "web/dist/index.html"
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        } else {
            reply file "web/dist/{filepath}"
        }
    }
}
