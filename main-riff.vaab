# riff — package registry at riff.vaab.dev
#
#   cd web && npm run build
#   vaab serve main-riff.vaab

choice ApiError {
    BadRequest(message: Text)
    Store(message: Text)
}

type Health {
    ok: Bool
    service: Text
}

type RiffStat {
    name: Text
    downloads: Int
}

type Tracked {
    ok: Bool
    downloads: Int
}

log.info("riff registry starting")

api_from_store(error: StoreError) returns ApiError {
    match error {
        when Failed(message) then { return ApiError.Store(message) }
    }
}

open_stats() returns Store or fails ApiError {
    match Store.open("riff-stats.vaab.kv") {
        when success store then { return store }
        when failure error then { fail api_from_store(error) }
    }
}

riff_ok(name: Text) returns Bool {
    if name.is_empty { return no }
    if name.contains("..") { return no }
    if name.contains("/") { return no }
    if name.contains(":") { return no }
    if name.contains(" ") { return no }
    return yes
}

track_prefix(name: Text) returns Text {
    return "track:{name}:"
}

seed_downloads(name: Text) returns Int {
    if name == "supabase" { return 1842 }
    if name == "tape" { return 956 }
    return 0
}

read_downloads(name: Text) returns Int or fails ApiError {
    if not riff_ok(name) {
        fail ApiError.BadRequest("bad riff name")
    }
    let seed = seed_downloads(name)
    if seed == 0 {
        fail ApiError.BadRequest("riff not found")
    }
    let store = try open_stats()
    let prefix = track_prefix(name)
    match store.from(prefix).count() {
        when success events then { return seed + events }
        when failure error then { fail api_from_store(error) }
    }
}

track_download(name: Text) returns Tracked or fails ApiError {
    if not riff_ok(name) {
        fail ApiError.BadRequest("bad riff name")
    }
    if seed_downloads(name) == 0 {
        fail ApiError.BadRequest("riff not found")
    }
    let store = try open_stats()
    let prefix = track_prefix(name)
    let key = "{prefix}{now()}"
    match store.from(prefix).insert({"key": key, "ts": "{now()}"}) {
        when success _ then {
            let downloads = try read_downloads(name)
            return Tracked.new(ok: yes, downloads: downloads)
        }
        when failure error then { fail api_from_store(error) }
    }
}

list_stats() returns [RiffStat] or fails ApiError {
    let supabase = try read_downloads("supabase")
    let tape = try read_downloads("tape")
    return [
        RiffStat.new(name: "supabase", downloads: supabase),
        RiffStat.new(name: "tape", downloads: tape),
    ]
}

riff_detail(name: Text) returns RiffStat or fails ApiError {
    let downloads = try read_downloads(name)
    return RiffStat.new(name: name, downloads: downloads)
}

explain(error: ApiError) returns Text {
    match error {
        when BadRequest(message) then { return message }
        when Store(message) then { return message }
    }
}

serve on port 8787 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    route get "/health" {
        reply with Health.new(ok: yes, service: "riff")
    }

    route get "/api/riffs" {
        reply with try list_stats()
    }

    route get "/api/riffs/{name: Text}" {
        reply with try riff_detail(name)
    }

    route post "/api/riffs/{name: Text}/track" {
        reply with try track_download(name)
    }

    when anything fails with ApiError as error {
        reply text explain(error) as "text/plain; charset=utf-8" status 400
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/packages/{name: Text}" {
        reply file "web/dist/index.html"
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        } else {
            reply file "web/dist/{filepath}"
        }
    }
}
