choice StoreError { Failed(message: Text) }

type Session can Json {
    user: Text
    role: Text
}

to session_json(store: Store, user: Text) returns Text or fails StoreError {
    match store.get("session:{user}") {
        when found role then {
            return success to_json(Session.new(user: user, role: role))
        }
        when nothing then {
            try store.set("session:{user}", "member")
            return success to_json(Session.new(user: user, role: "member"))
        }
    }
}

to bench() returns Int or fails StoreError {
    let store = try Store.open("benchmarks/.data/bench.kv")
    let changing i = 0
    while i < 200 {
        try session_json(store, "{i % 20}")
        i = i + 1
    }
    return success 0
}

match bench() {
    when success _ then {}
    when failure _ then {}
}
