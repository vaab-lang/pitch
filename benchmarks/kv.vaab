choice StoreError { Failed(message: Text) }

to bench() {
    match Store.open("benchmarks/.data/bench.kv") {
        when success store then {
            let changing i = 0
            while i < 200 {
                match store.from("session:").insert({
                    "key": "session:{i}",
                    "value": "signed-in",
                }) {
                    when success _ then { i = i + 1 }
                    when failure _ then { return }
                }
            }
            let changing j = 0
            while j < 200 {
                match store.from("session:").where_eq("key", "session:{j}").first() {
                    when success found_row then {
                        match found_row {
                            when found _ then { j = j + 1 }
                            when nothing then { j = j + 1 }
                        }
                    }
                    when failure _ then { return }
                }
            }
        }
        when failure _ then { return }
    }
}

bench()
